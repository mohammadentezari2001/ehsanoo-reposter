# ---------------------------------------------------------------------------
# Telegram Reposter — copy to .env and fill in.  Never commit the real .env.
# ---------------------------------------------------------------------------

# Required -------------------------------------------------------------------

# Token from @BotFather.
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# The channel to post into.  Either the numeric id (-100...) or @username.
CHANNEL_ID=@ehsanoo_podcast

# Your personal Telegram user id (get it from @userinfobot).  Only this user
# may run the admin commands.
ADMIN_USER_ID=123456789

# Scheduling -----------------------------------------------------------------
#
# These values are only the *defaults*.  All six scheduling values below can be
# changed at runtime from Telegram (/settings, /set_posts_per_day, ...); the new
# value is saved in SQLite, survives restarts, and wins over what is written
# here.  Use "/set_<name> default" to go back to the value in this file.

# IANA timezone used for every scheduling decision (not the VPS clock).
TIMEZONE=Asia/Tehran

# How many reposts per day.
POSTS_PER_DAY=4

# Daily posting window, local time.  END_HOUR=22 means "nothing after 22:00".
START_HOUR=8
END_HOUR=22

# The same window in HH:MM, if you want a half-hour boundary.  When set, these
# win over START_HOUR/END_HOUR above.  END_TIME=24:00 means midnight.
# START_TIME=08:30
# END_TIME=22:45

# Minimum gap between two posts, in minutes.
MIN_INTERVAL_MINUTES=120

# Jitter, in minutes, applied when picking each slot's exact time.  Capped at
# 15% of a slot, so posts can never drift outside the window.
RANDOMIZATION_MINUTES=60

# Daily mix.  A pattern of categories, cycled if POSTS_PER_DAY is larger.
# Valid categories: TEXT, IMAGE, VIDEO, AUDIO, FILE
# The order is shuffled per day, so this only controls the daily counts.
DAILY_MIX=TEXT,IMAGE,VIDEO,AUDIO

# Content selection ----------------------------------------------------------

# Do not reuse the same original post until this many days have passed.  Applies
# to scheduled and manual (/post) publishing alike.
REPOST_COOLDOWN_DAYS=7

# How many different archive entries to try before giving up on a slot.
MAX_SEND_ATTEMPTS=3

# A scheduled post that is this many minutes late is dropped instead of sent.
# This is what stops a restart from dumping several posts at once.
CATCHUP_MAX_LATE_MINUTES=90

# Archive --------------------------------------------------------------------

# Extra channels whose forwarded posts may be imported (comma separated).
EXTRA_SOURCE_CHAT_IDS=

# Let forwarded posts from the channel be added to the archive.
IMPORT_ENABLED=true

# Where /scan sends its probe copies before deleting them.  Defaults to the
# admin's private chat.  Point it at a scratch channel to avoid DM noise.
# SCAN_CHAT_ID=-1009876543210

# Delay between two /scan probes, in seconds.
SCAN_INTERVAL_SECONDS=0.7

# Storage and logging --------------------------------------------------------

DATABASE_PATH=data/reposter.sqlite3
LOG_LEVEL=INFO
# Set to "none" to log to stdout only.
LOG_FILE=data/bot.log

# Long-polling timeout, in seconds.
POLL_TIMEOUT=30
